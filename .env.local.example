# 复制为 .env.local 后填写
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# 可用 anon JWT，或新版 publishable key（sb_publishable_...）
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# 未配置上面两项时自动进入演示模式；也可强制：
# NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=false

# 企业微信群机器人 Webhook（仅服务端，设置页可一键推送红灯）
# WECOM_BOT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 定时推送（Vercel Cron / 外部调度）
# CRON_SECRET=random-long-string
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 可选，用于定时汇总完整红灯明细
